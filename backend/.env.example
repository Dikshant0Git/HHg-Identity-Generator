NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://localhost:27017/hhgoa

FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# ImageKit Persistent Image Upload Credentials
IMAGEKIT_PUBLIC_KEY=
